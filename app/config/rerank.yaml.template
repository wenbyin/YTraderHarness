# 第三方精排（RerankerType.API）的连接配置。
#
# 复制成 rerank.yaml 再改（真文件已 gitignore）。与 llm.yaml 同一套写法：
# ${NAME} / ${NAME:-默认值} 会在加载时按环境变量展开（见
# app/common/utils/env.py）。
#
# ⚠️ 凭据**只在这里**读，不进请求
# --------------------------------
# 请求里只带 model id（`RerankerConfig.model`）。把 key 塞进请求体的话，
# 它会跟着 `effective_config_snapshot` 落库、跟着响应回显，而"哪个请求
# 带过 key"事后无从审计。
#
# 端到端形状（已实测）
# ------------------
# 2026-10-16 用本机凭据实测，结论：
#
#   1. **OpenAI 兼容的 `/rerank`、`/reranks` 都是 404**（maas host 与
#      dashscope.aliyuncs.com 都试过）。所以默认 `protocol: dashscope`。
#   2. DashScope 原生端点 `{站点根}/api/v1/services/rerank/text-rerank/
#      text-rerank` 返回 200，maas host 与 dashscope.aliyuncs.com 都能用。
#      ⚠️ 注意是**站点根**：llm.yaml 里 qwen 的 base_url 带
#      `/compatible-mode/v1`，直接拼会 404 —— 实现里有 `_origin()` 负责
#      还原，不用在这里手工去掉。
#   3. 认证：`Authorization: Bearer <key>`。
#   4. 响应：`{"output": {"results": [{"index", "relevance_score"}]},
#      "usage": {...}}` —— index 是**送进去的顺序**，实现按它映射回候选。
#
# 剩下一个没量到的：**单次最多能送几段**（下面的 max_documents）。拿不准
# 就保守 —— 超上限会整批被拒，而实现只会 clamp 到这里的值并记 warning。

rerank:
  # 与 llm.yaml 的 qwen provider 同一个 host 与 key（都读 QWEN_API_KEY）。
  # 留空/没有这个文件时会自动从 llm.yaml 的 qwen provider 兜底。
  base_url: "${RERANK_BASE_URL:-https://maas.qianwenaiapi.com}"
  api_key: "${QWEN_API_KEY}"

  # dashscope = 原生 text-rerank（实测可用，默认）
  # openai    = {base_url}{path} + {model, query, documents, top_n}（本机实测 404）
  protocol: "${RERANK_PROTOCOL:-dashscope}"

  # openai 协议下的路径（dashscope 协议会忽略它，用内置的固定路径）。
  path: "${RERANK_PATH:-/rerank}"

  # 默认模型。阶梯里的第三轮也写死了一个同名的 —— 那份进快照（"这批数字
  # 是哪个模型跑的"要可查），这份是真正发请求时用的。
  model: "${RERANK_MODEL:-qwen3.7-text-rerank}"

  # 单次调用的墙钟上限。精排是逐案一次调用，而评测的单案超时是 60s
  # （CASE_TIMEOUT_SECONDS），这里要明显小于它。
  timeout_ms: 20000

  # 5xx / 超时的重试次数（不含首次）。重试期间**不**重算候选文本。
  max_retries: 1

  # 单次最多送几段候选。服务端有自己的上限，超了会整批被拒 ——
  # 实现会 clamp 到这里并记一条 warning（"送不满"比"整批失败"好）。
  max_documents: 50
